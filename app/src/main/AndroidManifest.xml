<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to receive the boot-completed broadcast -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Splash"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <!--
            SplashActivity is never exported and has no LAUNCHER intent filter.
            It is only ever started explicitly, by BootReceiver, from inside
            this app's own process.
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.Splash.Fullscreen"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape" />

        <!--
            SettingsActivity is the only launchable activity, so the app
            shows up once in the app drawer purely for configuration.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Listens for boot completion. android:directBootAware is left at
            its default (false) since a splash screen has no reason to run
            before the user's credential storage is unlocked.

            Multiple actions are registered because many automotive/aftermarket
            head unit ROMs use a vendor-specific "quick boot" broadcast instead
            of, or in addition to, the standard BOOT_COMPLETED broadcast.
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
